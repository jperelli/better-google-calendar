{
  "manifest_version": 3,
  "name": "Better Google Calendar",
  "version": "1.1.0",
  "description": "Quick-add events in plain words, templates, free-times text, hour totals, shading, dimming, .ics drop/paste. No account access.",
  "homepage_url": "https://github.com/jperelli/better-google-calendar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Google Calendar: press q on calendar.google.com to quick-add, Ctrl+K for the palette",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "src/ics.js",
        "src/gcal-url.js",
        "src/ics-write.js",
        "src/quickadd.js",
        "src/templates.js",
        "src/palette.js",
        "src/grid.js",
        "src/presets.js",
        "src/merge.js",
        "src/settings.js",
        "src/about.js",
        "src/content.js",
        "src/features/quick-add.js",
        "src/features/declutter.js",
        "src/features/grid-live.js",
        "src/features/grid-theme.js",
        "src/features/grid-events.js",
        "src/features/export.js",
        "src/features/availability.js",
        "src/features/settings-ui.js",
        "src/features/presets.js",
        "src/features/merge.js",
        "src/features/palette.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ]
}
