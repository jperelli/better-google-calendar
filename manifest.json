{
  "manifest_version": 3,
  "name": "Better Google Calendar",
  "version": "0.1.0",
  "description": "Drop .ics files onto Google Calendar, add events in plain words, and more improvements to come.",
  "homepage_url": "https://github.com/jperelli/better-google-calendar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Google Calendar: drop a .ics file onto calendar.google.com",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "src/ics.js",
        "src/gcal-url.js",
        "src/ics-write.js",
        "src/quickadd.js",
        "src/templates.js",
        "src/palette.js",
        "src/settings.js",
        "src/content.js",
        "src/features/quick-add.js",
        "src/features/palette.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
